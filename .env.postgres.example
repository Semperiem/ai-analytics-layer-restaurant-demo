# Copy to .env.postgres and replace the password before running.
# Do not commit .env.postgres.
POSTGRES_DB=restaurant_demo
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=change-me-strong-password
# Optional: bind host port 5435 to your Tailscale IP for direct laptop DB tools.
# If unset, docker-compose binds to 127.0.0.1 only.
TAILSCALE_IP=127.0.0.1
